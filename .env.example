# Host ports used by compose.yaml. Change them if something else already uses them.
DB_PORT=5432
MAILPIT_PORT=8025
WEB_PORT=8080

# API (apps/api). These values are for `pnpm dev` on the host.
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/app
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-32ch
# The origin the browser uses. In dev that is the Vite server, which proxies /api and /rpc.
BETTER_AUTH_URL=http://localhost:5173

# Email: "mailpit" locally, "resend" in production.
MAIL_PROVIDER=mailpit
MAILPIT_URL=http://localhost:8025
MAIL_FROM=App <noreply@example.com>
RESEND_API_KEY=

# Optional OAuth. A provider is turned on only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional error tracking. Empty means Sentry is off.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Optional central sign-in. Set all three together in an app deployment.
ALTIVOLA_AUTH_ISSUER=
ALTIVOLA_AUTH_CLIENT_ID=
ALTIVOLA_AUTH_CLIENT_SECRET=

# "app" serves Starter. "hub" runs Altivola Auth on a separate origin and database.
AUTH_MODE=app
