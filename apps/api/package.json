{
  "name": "@app/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/node.ts",
    "build": "tsx scripts/build.ts",
    "start": "node --enable-source-maps dist/node.js",
    "openapi": "tsx scripts/openapi.ts",
    "typecheck": "tsc -p . && wrangler types src/cloudflare/worker-configuration.d.ts > /dev/null && tsc -p tsconfig.worker.json",
    "dev:worker": "wrangler dev",
    "deploy": "pnpm --filter @app/web build && wrangler deploy"
  },
  "dependencies": {
    "@app/api": "workspace:*",
    "@app/auth": "workspace:*",
    "@app/db": "workspace:*",
    "@hono/node-server": "^2.1.9",
    "@orpc/openapi": "^1.16.2",
    "@orpc/server": "^1.16.2",
    "@orpc/zod": "^1.16.2",
    "@sentry/node": "^11.13.0",
    "hono": "^4.13.19",
    "pg-boss": "^12.38.2",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "wrangler": "^4.164.0"
  }
}
