{
  "name": "starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "openapi": "pnpm --filter @app/server openapi",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "env:pull": "node scripts/secrets.ts pull",
    "secrets:push": "node scripts/secrets.ts push"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
