{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Jakarta",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Auto merge minor and patch updates of stable packages when CI is green",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    },
    {
      "description": "Keep the Better Auth library and its CLI on the same version",
      "matchPackageNames": ["better-auth", "auth"],
      "groupName": "better-auth"
    },
    {
      "matchPackageNames": ["/^@orpc//"],
      "groupName": "orpc"
    }
  ]
}
